# Environment variable names read by the Ideal Day agent bridge (bridge/ideal-day-bridge.mjs).
# Names only: never commit values. Local development needs none of them, because
# the app accepts bridge requests from localhost without a token.
# Load them with, for example: node --env-file=.env bridge/ideal-day-bridge.mjs

# URL of the running app. Defaults to http://localhost:3000.
IDEAL_DAY_APP_URL=http://localhost:3000

# Required only when IDEAL_DAY_APP_URL is not localhost: the bearer token the app
# checks on /api/agent/jobs (the same value must be set as IDEAL_DAY_BRIDGE_TOKEN
# on the app), and the hosting platform's private-site bypass token.
IDEAL_DAY_BRIDGE_TOKEN=
IDEAL_DAY_SITES_BYPASS_TOKEN=

# Local Hermes agent runtime that the bridge calls (see AGENTS.md).
IDEAL_DAY_HERMES_URL=http://127.0.0.1:8643
# Directory of the `ideal-day` Hermes profile (contains config.yaml). Defaults to
# %LOCALAPPDATA%\hermes\profiles\ideal-day on Windows.
IDEAL_DAY_HERMES_HOME=

# Optional model overrides. Defaults are set in the bridge source.
IDEAL_DAY_CONVERSATIONAL_MODEL=
IDEAL_DAY_WORKSPACE_MODEL=

# Optional settings for `npm run eval:model-routing` (see evals/README.md).
IDEAL_DAY_EVAL_RUNS=
IDEAL_DAY_EVAL_CONFIGS=

# The password gateway has its own template: vercel-gateway/.env.example.
